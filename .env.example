# IDataProject Environment Configuration Template
# Copy to .env and fill in actual values (DO NOT COMMIT .env to Git)

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=idata_dev
POSTGRES_PORT=5432

# === Odoo ===
ODOO_ADMIN_PASSWD=change_me_to_strong_password
ODOO_DB_NAME=idata_dev
ODOO_SUPERADMIN_PASSWD=change_me_to_admin_password
ODOO_LOG_LEVEL=info
ODOO_WORKERS=4

# === Odoo Module: stock_barcode_rfid ===
# API rate limiting
RFID_API_RATE_LIMIT=100  # requests per minute
RFID_API_BURST_LIMIT=50  # max EPCs per burst

# Deduplication window
RFID_DEDUP_WINDOW_SEC=2

# SSE/Long-poll timeout
RFID_STREAM_TIMEOUT_SEC=30

# === Calibration Defaults (Phase 4) ===
RFID_POWER_DEFAULT_DBM=28
RFID_SESSION_DEFAULT=1
RFID_RSSI_FLOOR_DEFAULT=-68

# === Android App (Configuration) ===
ODOO_API_URL=http://10.0.2.2:8069  # 10.0.2.2 = Android emulator's localhost
ODOO_API_KEY=to_be_generated_in_phase_2  # Generated by Odoo, stored in Android Keystore
ANDROID_DEVICE_ID=zebra_t1_serial_abc  # Serial of pilot Zebra device

# === Redis (for caching & async) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Leave empty if no auth

# === Celery (async task processing, Phase 5+) ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_LOG_LEVEL=info

# === Email (Mailhog for testing) ===
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@idataproject.local

# === Monitoring & Logging ===
LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR
SENTRY_DSN=  # For error tracking (Phase 7)
SENTRY_ENVIRONMENT=development

# === Security ===
HTTPS_ENABLED=false  # true in production
TLS_CERT_PATH=/etc/ssl/certs/server.crt
TLS_KEY_PATH=/etc/ssl/private/server.key
CERTIFICATE_PIN=  # Certificate hash for Android TLS pinning (Phase 2)

# === Feature Flags ===
ENABLE_RFID_SCANNING=true
ENABLE_OFFLINE_QUEUE=true
ENABLE_CALIBRATION_PROFILES=false  # Enable in Phase 4

# === Development ===
DEBUG=false
DEVELOPMENT_MODE=true
ALLOW_CROSS_ORIGIN=true  # CORS for local testing
MOCK_ZEBRA_READER=false  # Simulate Zebra reader in unit tests
